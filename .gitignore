# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
.claude/

# ── BAKED STREAMING ASSETS ARE NEVER COMMITTED ──────────────────────────────
# public/assets/<model>/assets/ is local staging only — hundreds of MB of chunk
# GLBs and texture rungs per model, all regenerable from the source GLB by the
# bake in the LA_PORT_ADAPTIVE repo (`npm run bake <model>`). Serve them by
# pointing NEXT_PUBLIC_ASSET_BASE at an S3/CDN base, or leave it unset to serve
# this local copy from /assets.
/public/assets/*/assets/
public/**/*.zip

# Timestamped copies of site.json, written by /admin before it overwrites the
# file. Local safety net for an uncommitted state; never part of the repo.
/.site-backups/
